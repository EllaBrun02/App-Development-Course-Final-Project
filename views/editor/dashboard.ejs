<%
  let pageTitle, extraHead = '', extraScripts = '';
  pageTitle = 'Editor Dashboard';
  extraScripts = '<script src="/js/editor.js"></script>';
%>
<%- include('../partials/header', { pageTitle, extraHead }) %>

<div class="dashboard-page">
  <div class="dashboard-header">
    <h1>Editor Dashboard</h1>
    <a class="btn btn-outline" href="/editor/manage">Data management</a>
  </div>

  <form class="filter-form" method="GET" action="/editor">
    <label class="sr-only" for="article-search">Search articles</label>
    <input class="filter-select" id="article-search" name="search" type="search" maxlength="200" placeholder="Search articles" value="<%= search %>">
    <select aria-label="Filter by status" name="status" class="filter-select">
      <option value="">All Statuses</option>
      <option value="draft" <%= filterStatus === 'draft' ? 'selected' : '' %>>Draft</option>
      <option value="pending" <%= filterStatus === 'pending' ? 'selected' : '' %>>Pending Review</option>
      <option value="published" <%= filterStatus === 'published' ? 'selected' : '' %>>Published</option>
      <option value="returned" <%= filterStatus === 'returned' ? 'selected' : '' %>>Returned</option>
    </select>
    <select aria-label="Filter by category" name="category" class="filter-select">
      <option value="">All Categories</option>
      <% categories.forEach(cat => { %>
        <option value="<%= cat %>" <%= filterCategory === cat ? 'selected' : '' %>><%= cat %></option>
      <% }); %>
    </select>
    <button type="submit" class="btn btn-primary">Filter</button>
    <a href="/editor" class="btn btn-outline">Clear</a>
  </form>

  <% if (articles.length === 0) { %>
    <div class="empty-state"><p>No articles match your filters.</p></div>
  <% } else { %>
    <div class="articles-table-wrap">
      <table class="articles-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            <th>Status</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% articles.forEach(a => { %>
            <tr>
              <td class="col-title"><%= a.title %></td>
              <td><%= a.author ? a.author.name : '—' %></td>
              <td><span class="badge"><%= a.category %></span></td>
              <td>
                <span class="status-badge status-<%= a.status %>">
                  <%= a.status === 'draft' ? 'Draft' :
                      a.status === 'pending' ? 'Pending Review' :
                      a.status === 'published' ? 'Published' :
                      'Returned' %>
                </span>
                <% if (a.pendingUpdate && a.pendingUpdate.status === 'pending') { %>
                  <span class="status-badge status-pending tag-small">Update Pending</span>
                <% } %>
              </td>
              <td class="col-date">
                <% if (a.publishedAt) { %>
                  <%= a.publishedAt.toLocaleDateString() %>
                <% } else { %>
                  <%= a.createdAt.toLocaleDateString() %>
                <% } %>
              </td>
              <td class="col-actions">
                <a href="/editor/articles/<%= a._id %>" class="btn btn-sm btn-outline">Review</a>
                <a href="/editor/articles/<%= a._id %>/edit" class="btn btn-sm btn-outline">Edit</a>
                <% if (a.status === 'published') { %>
                  <a href="/article/<%= a._id %>" class="btn btn-sm btn-outline">View Live</a>
                  <a href="/editor/analytics/<%= a._id %>" class="btn btn-sm btn-analytics">Analytics</a>
                <% } %>
                <button class="btn btn-sm btn-danger delete-btn" data-id="<%= a._id %>">Delete</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <%# Dashboard is paginated on the server (50 per page) %>
    <% if (totalPages > 1) { %>
      <%
        const baseParams = [];
        if (typeof search !== 'undefined' && search) baseParams.push('search=' + encodeURIComponent(search));
        if (filterStatus) baseParams.push('status=' + encodeURIComponent(filterStatus));
        if (filterCategory) baseParams.push('category=' + encodeURIComponent(filterCategory));
        const pageUrl = (p) => '/editor?' + baseParams.concat('page=' + p).join('&');
      %>
      <nav class="pagination" aria-label="Dashboard pages">
        <% if (page > 1) { %>
          <a href="<%= pageUrl(page - 1) %>" class="btn btn-sm btn-outline">&larr; Previous</a>
        <% } %>
        <span class="pagination-info">Page <%= page %> of <%= totalPages %> (<%= totalCount %> articles)</span>
        <% if (page < totalPages) { %>
          <a href="<%= pageUrl(page + 1) %>" class="btn btn-sm btn-outline">Next &rarr;</a>
        <% } %>
      </nav>
    <% } %>
  <% } %>
</div>

<%- include('../partials/footer', { extraScripts }) %>
