<%
  let pageTitle, extraHead = '', extraScripts = '';
  // Saving a published article creates a new pending article linked to it.
  const createsEdit = article.status === 'published';
  const fixedCategory = createsEdit || !!article.revisionOf;
  pageTitle = 'Edit: ' + article.title;
  extraScripts = `<script>
    window.ARTICLE_ID = ${JSON.stringify(article._id.toString())};
  </script>
  <script src="/js/editor-edit.js"></script>`;
%>
<%- include('../partials/header', { pageTitle, extraHead }) %>

<div class="editor-page">
  <div class="dashboard-header">
    <div>
      <h1><%= createsEdit ? 'Edit Published Article' : 'Edit Article' %></h1>
      <p class="analytics-meta">
        By <%= article.author ? article.author.name : '—' %> &bull;
        <%- include('../partials/status-badge', { status: article.status }) %>
      </p>
    </div>
    <div class="header-actions">
      <a href="/editor/articles/<%= article._id %>" class="btn btn-outline">&larr; Back to Review</a>
      <a href="/editor" class="btn btn-outline">Dashboard</a>
    </div>
  </div>

  <% if (createsEdit) { %><p class="info-banner">Saving creates a new article with status Pending Review, linked to this one. Readers keep seeing the published version until you approve the edit on its review page.</p><% } %>
  <% if (article.revisionOf) { %><p class="info-banner">This is an edit of a published article. Approving it replaces the <a href="/article/<%= article.revisionOf %>">published version</a>.</p><% } %>
  <div id="edit-message" class="action-message hidden" role="status" aria-live="polite"></div>

  <form id="editor-edit-form" class="article-edit-form" data-revision="<%= article.__v %>" data-partial="<%= article.status === 'draft' %>">
    <div class="form-group">
      <label for="edit-title">Title <span class="required">*</span></label>
      <input type="text" id="edit-title" class="form-control" value="<%= article.title %>" maxlength="200" <%= article.status === 'draft' ? '' : 'required' %> />
    </div>

    <div class="form-group">
      <label for="edit-category">Category</label>
      <select id="edit-category" class="filter-select" <%= fixedCategory ? 'disabled' : '' %>>
        <% categories.forEach(cat => { %>
          <option value="<%= cat %>" <%= article.category === cat ? 'selected' : '' %>><%= cat %></option>
        <% }); %>
      </select>
    </div>

    <div class="form-group">
      <label for="edit-image">Image URL</label>
      <input type="url" id="edit-image" class="form-control" value="<%= article.image || '' %>" placeholder="https://..." />
    </div>

    <div class="form-group">
      <label for="edit-summary">Summary <span class="required">*</span></label>
      <textarea id="edit-summary" class="form-control" rows="3" maxlength="500" <%= article.status === 'draft' ? '' : 'required' %>><%= article.summary %></textarea>
    </div>

    <div class="form-group">
      <label for="edit-content">Content <span class="required">*</span></label>
      <textarea id="edit-content" class="form-control article-content-textarea" rows="20" maxlength="100000" <%= article.status === 'draft' ? '' : 'required' %>><%= article.content %></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" id="save-btn" class="btn btn-primary">Save Changes</button>
      <a href="/editor/articles/<%= article._id %>" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer', { extraScripts }) %>
