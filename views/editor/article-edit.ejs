<%
  pageTitle = 'Edit: ' + article.title;
  extraScripts = `<script>
    window.ARTICLE_ID = ${JSON.stringify(article._id.toString())};
  </script>
  <script src="/js/editor-edit.js"></script>`;
%>
<%- include('../partials/header') %>

<div class="editor-page">
  <div class="dashboard-header">
    <div>
      <h1>Edit Article</h1>
      <p class="analytics-meta">
        By <%= article.author ? article.author.name : '—' %> &bull;
        <span class="status-badge status-<%= article.status %>"><%= article.status %></span>
      </p>
    </div>
    <div style="display:flex;gap:0.5rem">
      <a href="/editor/articles/<%= article._id %>" class="btn btn-outline">&larr; Back to Review</a>
      <a href="/editor" class="btn btn-outline">Dashboard</a>
    </div>
  </div>

  <div id="edit-message" class="action-message hidden"></div>

  <div class="article-editor-form">
    <div class="form-group">
      <label for="edit-title">Title <span class="required">*</span></label>
      <input type="text" id="edit-title" class="form-control" value="<%= article.title %>" maxlength="200" required />
    </div>

    <div class="form-group">
      <label for="edit-category">Category</label>
      <select id="edit-category" class="filter-select">
        <% categories.forEach(cat => { %>
          <option value="<%= cat %>" <%= article.category === cat ? 'selected' : '' %>><%= cat %></option>
        <% }); %>
      </select>
    </div>

    <div class="form-group">
      <label for="edit-image">Image URL</label>
      <input type="url" id="edit-image" class="form-control" value="<%= article.image || '' %>" placeholder="https://..." />
    </div>

    <div class="form-group">
      <label for="edit-summary">Summary <span class="required">*</span></label>
      <textarea id="edit-summary" class="form-control" rows="3" maxlength="500" required><%= article.summary %></textarea>
    </div>

    <div class="form-group">
      <label for="edit-content">Content <span class="required">*</span></label>
      <textarea id="edit-content" class="form-control article-content-textarea" rows="20" required><%= article.content %></textarea>
    </div>

    <div class="form-actions">
      <button id="save-btn" class="btn btn-primary">Save Changes</button>
      <a href="/editor/articles/<%= article._id %>" class="btn btn-outline">Cancel</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
