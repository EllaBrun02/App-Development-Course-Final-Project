<%
  pageTitle = 'Review: ' + article.title;
  const hasUpdate = article.pendingUpdate && article.pendingUpdate.status === 'pending';
  extraHead = hasUpdate ? '<script src="https://cdn.jsdelivr.net/npm/diff@5.2.0/dist/diff.min.js"></script>' : '';
  extraScripts = `<script>
    window.ARTICLE_ID = ${JSON.stringify(article._id.toString())};
    window.HAS_UPDATE = ${hasUpdate};
    window.ARTICLE_STATUS = ${JSON.stringify(article.status)};
    ${hasUpdate ? `
    window.DIFF_OLD = ${JSON.stringify({ title: article.title, summary: article.summary, content: article.content })};
    window.DIFF_NEW = ${JSON.stringify({ title: article.pendingUpdate.title, summary: article.pendingUpdate.summary, content: article.pendingUpdate.content })};
    ` : ''}
  </script>
  <script src="/js/editor-review.js"></script>`;
%>
<%- include('../partials/header') %>

<div class="review-page">
  <div class="dashboard-header">
    <h1>Article Review</h1>
    <a href="/editor" class="btn btn-outline">&larr; Dashboard</a>
  </div>

  <% if (hasUpdate) { %>
    <style>
      ins.diff-add { background: #d4f7d4; color: #155724; text-decoration: none; border-radius: 2px; padding: 0 1px; }
      del.diff-del { background: #fdd; color: #721c24; text-decoration: line-through; border-radius: 2px; padding: 0 1px; }
      .diff-field-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #6b7280; margin: 1rem 0 0.25rem; }
      .diff-content { white-space: pre-wrap; line-height: 1.7; }
    </style>
    <div class="update-compare">
      <div class="version-panel">
        <div class="version-label published">Currently Published</div>
        <div class="diff-field-label">Title</div>
        <div id="diff-title-old" class="diff-content"></div>
        <div class="diff-field-label">Summary</div>
        <div id="diff-summary-old" class="diff-content"></div>
        <div class="diff-field-label">Content</div>
        <div id="diff-content-old" class="diff-content"></div>
      </div>
      <div class="version-panel">
        <div class="version-label pending">Pending Update</div>
        <div class="diff-field-label">Title</div>
        <div id="diff-title-new" class="diff-content"></div>
        <div class="diff-field-label">Summary</div>
        <div id="diff-summary-new" class="diff-content"></div>
        <div class="diff-field-label">Content</div>
        <div id="diff-content-new" class="diff-content"></div>
      </div>
    </div>
    <div class="review-actions">
      <button id="approve-update-btn" class="btn btn-primary">Approve Update</button>
      <button id="return-update-btn" class="btn btn-danger">Return Update</button>
    </div>
  <% } else { %>
    <div class="article-review-content">
      <div class="review-meta">
        <span class="badge"><%= article.category %></span>
        <span class="status-badge status-<%= article.status %>"><%= article.status %></span>
        <span>By: <%= article.author ? article.author.name : '—' %></span>
      </div>
      <h2 id="review-title"><%= article.title %></h2>
      <% if (article.image) { %><img src="<%= article.image %>" alt="" class="review-image"><% } %>
      <p class="review-summary"><strong>Summary:</strong> <%= article.summary %></p>
      <div class="review-body"><%= article.content.replace(/\n/g, '<br>') %></div>
    </div>

    <% if (article.status === 'pending') { %>
      <div class="review-actions">
        <button id="publish-btn" class="btn btn-primary">Publish</button>
        <button id="return-btn" class="btn btn-danger">Return to Reporter</button>
      </div>
    <% } %>
  <% } %>

  <div id="return-form" class="return-form hidden">
    <label for="editor-note">Note for reporter <span class="required">*</span></label>
    <textarea id="editor-note" rows="4" placeholder="Explain what needs to be corrected..."></textarea>
    <div class="form-actions">
      <button id="send-return-btn" class="btn btn-danger">Send Back</button>
      <button id="cancel-return-btn" class="btn btn-outline">Cancel</button>
    </div>
  </div>

  <div id="action-message" class="action-message hidden"></div>
</div>

<%- include('../partials/footer') %>
