<%
  let pageTitle, extraHead = '', extraScripts = '';
  pageTitle = 'Latest News';
  extraHead = '<link rel="stylesheet" href="/css/home.css">';
  extraScripts = '<script src="/js/home.js"></script>';
%>
<%- include('partials/header', { pageTitle, extraHead }) %>

<section class="edition-heading" aria-labelledby="edition-title">
  <div class="edition-intro"><h1 id="edition-title">Today’s edition.</h1>
  <p class="edition-description">World news. New ideas. Different perspectives.</p></div>
  <div class="edition-details"><p class="edition-date"><%= new Date().toLocaleDateString('en-US', { weekday: 'long' }) %><br><strong><%= new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></strong></p>
  <a href="#latest-news" class="edition-link">Start reading <span aria-hidden="true">↓</span></a></div>
</section>
<div class="content-with-sidebar home-layout">
  <main class="main-content">
    <div class="feed-heading" id="latest-news"><h2>Latest stories</h2><span class="live-label">Fresh from the newsroom</span></div>
    <div class="feed-toolbar" role="search" aria-label="Find articles">
      <div class="search-row">
        <input id="search-input" type="search" aria-label="Search articles" placeholder="Find a story, topic, or headline…" class="search-input" />
        <button id="search-btn" class="btn btn-primary">Search</button>
      </div>
      <div class="filters-row">
        <select aria-label="Filter by category" id="category-filter" class="filter-select">
          <option value="">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>"><%= cat %></option>
          <% }); %>
        </select>
        <select aria-label="Filter by reading history" id="viewed-filter" class="filter-select">
          <option value="">All Articles</option>
          <option value="viewed">Viewed</option>
          <option value="unviewed">Not Viewed</option>
        </select>
        <select aria-label="Sort articles" id="sort-select" class="filter-select">
          <option value="date">Newest First</option>
          <option value="popularity">Most Popular</option>
        </select>
      </div>
    </div>

    <div class="loading-spinner hidden" id="initial-spinner" role="status">Loading stories…</div>
    <div id="articles-feed" class="articles-feed" aria-busy="true"></div>
    <p id="feed-status" class="sr-only" role="status"></p>

    <div id="load-more-trigger" class="load-more-trigger"></div>
    <div id="loading-more" class="loading-more hidden" role="status">Loading more articles...</div>
    <div id="no-more" class="no-more hidden" role="status">You’re all caught up.</div>
  </main>

  <aside class="sidebar">
    <%- include('partials/weather') %>
    <div class="categories-widget">
      <h3 class="widget-title">Explore topics</h3>
      <ul class="categories-list">
        <% categories.forEach(cat => { %>
          <li><a href="#latest-news" class="category-link" data-category="<%= cat %>"><%= cat %><span aria-hidden="true">↗</span></a></li>
        <% }); %>
      </ul>
    </div>
  </aside>
</div>

<%- include('partials/footer', { extraScripts }) %>
