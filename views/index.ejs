<%
  pageTitle = 'Latest News';
  extraHead = '<link rel="stylesheet" href="/css/home.css">';
  extraScripts = '<script src="/js/home.js"></script>';
%>
<%- include('partials/header') %>

<div class="content-with-sidebar">
  <main class="main-content">
    <div class="feed-toolbar">
      <div class="search-row">
        <input id="search-input" type="text" placeholder="Search articles..." class="search-input" />
        <button id="search-btn" class="btn btn-primary">Search</button>
      </div>
      <div class="filters-row">
        <select id="category-filter" class="filter-select">
          <option value="">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>"><%= cat %></option>
          <% }); %>
        </select>
        <select id="viewed-filter" class="filter-select">
          <option value="">All Articles</option>
          <option value="viewed">Viewed</option>
          <option value="unviewed">Not Viewed</option>
        </select>
        <select id="sort-select" class="filter-select">
          <option value="date">Newest First</option>
          <option value="popularity">Most Popular</option>
        </select>
      </div>
    </div>

    <div id="articles-feed" class="articles-feed">
      <div class="loading-spinner" id="initial-spinner">Loading articles...</div>
    </div>

    <div id="load-more-trigger" class="load-more-trigger"></div>
    <div id="loading-more" class="loading-more hidden">Loading more articles...</div>
    <div id="no-more" class="no-more hidden">No more articles</div>
  </main>

  <aside class="sidebar">
    <%- include('partials/weather') %>
    <div class="categories-widget">
      <h3 class="widget-title">Categories</h3>
      <ul class="categories-list">
        <% categories.forEach(cat => { %>
          <li><a href="#" class="category-link" data-category="<%= cat %>"><%= cat %></a></li>
        <% }); %>
      </ul>
    </div>
  </aside>
</div>

<%- include('partials/footer') %>
